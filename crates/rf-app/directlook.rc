// App icon: id 1 is what GPUI loads for its windows (platform.rs load_icon), and the tray icon too (rf_win::tray::app_icon).
// A magnifier with the bolt, not rustyfiles' folder: the two icons side by side in the tray must tell apart at a glance
// (Discord, 2026-11-23). Drawn from assets/directlook.svg and directlook-small.svg (24 px and below).
1 ICON "assets/directlook.ico"

// The name Windows shows (Open with, Default apps, Task Manager).
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041F04B0"
    BEGIN
      VALUE "FileDescription", "DirectLook"
      VALUE "ProductName", "rustyfiles"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "directlook.exe"
      VALUE "InternalName", "directlook"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x041F, 0x04B0
  END
END
